<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Inherited by the Magento\CatalogSearch\Block\SearchResult\ListProduct virtual type. -->
    <type name="Magento\Catalog\Block\Product\ListProduct">
        <plugin name="run_as_root_typesense_skip_product_collection"
                type="RunAsRoot\TypeSense\Plugin\Catalog\SkipProductCollectionPlugin"/>
    </type>
    <!-- These subclasses list their own product sets, not the page's category/search listing. -->
    <type name="Magento\Catalog\Block\Product\ProductList\Promotion">
        <plugin name="run_as_root_typesense_skip_product_collection" disabled="true"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Random">
        <plugin name="run_as_root_typesense_skip_product_collection" disabled="true"/>
    </type>

    <type name="Magento\CatalogSearch\Controller\Result\Index">
        <plugin name="run_as_root_typesense_cacheable_search_result"
                type="RunAsRoot\TypeSense\Plugin\CatalogSearch\CacheableSearchResultPlugin"/>
    </type>
</config>
