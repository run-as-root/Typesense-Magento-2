<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\View\Element\Template;
use RunAsRoot\TypeSense\ViewModel\Frontend\ClientConfigViewModel;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

/** @var ClientConfigViewModel $viewModel */
$viewModel = $block->getData('view_model');
if (!$viewModel->isEnabled()) {
    return;
}

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    (() => {
        const ns = window.runAsRootTypesense = window.runAsRootTypesense || {};
        if (ns.getClient) {
            return;
        }

        const config = <?= /* @noEscape */ $viewModel->getJsonClientConfig() ?>;
        const LIBRARY_URL = 'https://cdn.jsdelivr.net/npm/typesense@1.8.2/dist/typesense.min.js';
        const LIBRARY_SRI = 'sha384-b1Uj2Udv6vFZ+nH6F6SaFpWpjpTqGXdfReSsqJhHUVr8yp2AehtZG/2EpA1dw0SN';
        let clientPromise = null;

        const loadLibrary = () => new Promise((resolve, reject) => {
            if (window.Typesense) {
                resolve(window.Typesense);
                return;
            }
            const script = document.createElement('script');
            script.src = LIBRARY_URL;
            script.integrity = LIBRARY_SRI;
            script.crossOrigin = 'anonymous';
            script.async = true;
            script.onload = () => window.Typesense
                ? resolve(window.Typesense)
                : reject(new Error('typesense-js loaded without defining window.Typesense'));
            script.onerror = () => {
                // Drop the failed tag so the next getClient() call can inject a fresh one.
                script.remove();
                reject(new Error('typesense-js could not be loaded'));
            };
            document.head.appendChild(script);
        });

        ns.getClient = () => {
            if (!clientPromise) {
                clientPromise = loadLibrary().then((Typesense) => new Typesense.Client({
                    nodes: [{ host: config.host, port: String(config.port), protocol: config.protocol }],
                    apiKey: config.apiKey,
                    connectionTimeoutSeconds: 10,
                }));
                clientPromise.catch(() => {
                    clientPromise = null;
                });
            }

            return clientPromise;
        };
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
