<?php
/**
 * Header search dropdown, popular searches of `typesenseHeaderSearch` (Popular Searches Count): the store's most
 * popular search terms as links to the search page, shown with and without a query.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;

/** @var Escaper $escaper */
?>
<div x-show="hasPopular" role="group" aria-labelledby="typesense-ac-popular-title" class="border-b border-gray-200 p-2">
    <p id="typesense-ac-popular-title" class="mb-1 px-2 text-xs font-bold uppercase tracking-wide text-gray-500"><?= $escaper->escapeHtml(__('Popular searches')) ?></p>
    <div class="flex flex-wrap gap-2 px-2 py-1">
        <template x-for="chip in popular" :key="chip.key">
            <a :href="chip.url"
               @click="onPopularClick"
               class="rounded-full border border-gray-300 px-3 py-1 text-sm text-gray-800 hover:bg-gray-100"
               x-text="chip.name"></a>
        </template>
    </div>
</div>
