<?php
/**
 * Alpine component `typesenseHeaderSearch` of the header search (search/form-mini.phtml and search/autocomplete/*),
 * rendered by the `typesense_script` child block, so theme overrides of those templates stay markup-only. Its
 * argument-free template API is listed in the README (Frontend > Autocomplete).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    function initTypesenseHeaderSearch() {
        const core = () => window.runAsRootTypesense && window.runAsRootTypesense.listing;
        const strings = {
            minLength: '<?= $escaper->escapeJs(__('Minimum Search query length is %1')) ?>',
            seeAll: '<?= $escaper->escapeJs(__('See all (%1)')) ?>',
            noResults: '<?= $escaper->escapeJs(__('No products for "%1"')) ?>',
            foundOne: '<?= $escaper->escapeJs(__('%1 result')) ?>',
            foundMany: '<?= $escaper->escapeJs(__('%1 results')) ?>',
        };
        const DEBOUNCE_MS = 300;
        const EMPTY_SECTIONS = { suggestions: [], products: [], categories: [], pages: [] };
        // Kept out of the reactive data: they only decide which response may still render.
        let sequencer = null;
        let debounceTimer = null;
        // Popular searches do not depend on the query, so they are requested once per page.
        let popularRequested = false;
        // Cards by request: retyping a query with the same top hit sends nothing.
        const crossSellCache = new Map();
        const sequence = () => {
            if (!sequencer && core()) {
                sequencer = core().createSequencer();
            }

            return sequencer;
        };

        return {
            config: {},
            query: '',
            searchedTerm: '',
            isOpen: false,
            sections: EMPTY_SECTIONS,
            rows: [],
            found: 0,
            activeIndex: -1,
            crossSells: [],
            popular: [],

            init() {
                const configElement = this.$root.querySelector('[data-typesense-autocomplete-config]');
                try {
                    this.config = JSON.parse(configElement ? configElement.textContent : '{}');
                } catch (e) {
                    this.config = {};
                }
                this.query = this.$refs.input.value;
                // typesense-js is only fetched once the shopper shows intent to search.
                const warmUp = () => window.runAsRootTypesense.getClient().catch(() => {});
                this.$refs.input.addEventListener('focus', warmUp, { once: true });
                this.$refs.input.addEventListener('pointerenter', warmUp, { once: true });
            },

            minQueryLength() {
                return Number(this.config.minQueryLength) || 1;
            },
            isQueryLongEnough() {
                return this.query.trim().length >= this.minQueryLength();
            },

            onInput() {
                this.query = this.$event.target.value;
                this.$refs.input.setCustomValidity('');
                clearTimeout(debounceTimer);
                if (!this.isQueryLongEnough()) {
                    // A pending response for a longer query must not reopen the dropdown.
                    if (sequence()) {
                        sequence().next();
                    }
                    this.reset();
                    this.openPopular();
                    return;
                }
                debounceTimer = setTimeout(() => this.search(), DEBOUNCE_MS);
            },

            onFocus() {
                const term = this.query.trim();
                if (this.searchedTerm !== '' && this.searchedTerm === term) {
                    this.isOpen = true;
                } else if (this.isQueryLongEnough()) {
                    this.search();
                } else {
                    this.loadPopular();
                    this.openPopular();
                }
            },

            async search() {
                const listing = core();
                const requests = sequence();
                if (!listing || !requests) {
                    this.reset();
                    return;
                }
                const term = this.query.trim();
                const id = requests.next();
                try {
                    const plan = listing.buildAutocompleteSearches(term, this.config);
                    const client = await window.runAsRootTypesense.getClient();
                    const response = await client.multiSearch.perform({ searches: plan.searches }, this.config.cacheParams);
                    if (!requests.isCurrent(id)) {
                        return;
                    }
                    const result = listing.autocompleteResults((response && response.results) || [], plan.sources, term, this.config);
                    this.sections = result.sections;
                    this.rows = result.rows;
                    this.found = result.found;
                    this.searchedTerm = term;
                    this.activeIndex = -1;
                    this.isOpen = this.$root.contains(document.activeElement);
                    this.loadCrossSells(listing, result, id);
                } catch (error) {
                    if (!requests.isCurrent(id)) {
                        return;
                    }
                    // The dropdown disappears; the form still submits to the search page.
                    console.error('Typesense autocomplete request failed', error);
                    this.reset();
                }
            },

            // Sent after the hits are shown, so the cards never delay them; a failure only leaves the cards out.
            async loadCrossSells(listing, result, id) {
                const shownIds = result.sections.products.map(row => row.id);
                const plan = listing.buildCrossSellSearches(result.topDocument, shownIds, this.config);
                if (!plan) {
                    this.crossSells = [];
                    return;
                }
                if (crossSellCache.has(plan.key)) {
                    this.crossSells = crossSellCache.get(plan.key);
                    return;
                }
                this.crossSells = [];
                try {
                    const client = await window.runAsRootTypesense.getClient();
                    const response = await client.multiSearch.perform({ searches: plan.searches }, this.config.cacheParams);
                    const cards = listing.crossSellResults((response && response.results) || [], plan.sources, this.config);
                    crossSellCache.set(plan.key, cards);
                    if (sequence().isCurrent(id)) {
                        this.crossSells = cards;
                    }
                } catch (error) {
                    console.error('Typesense cross-sell request failed', error);
                }
            },

            async loadPopular() {
                const listing = core();
                const search = listing ? listing.buildPopularSearch(this.config) : null;
                if (!search || popularRequested) {
                    return;
                }
                popularRequested = true;
                try {
                    const client = await window.runAsRootTypesense.getClient();
                    const response = await client.multiSearch.perform({ searches: [search] }, this.config.cacheParams);
                    this.popular = listing.popularResults(((response && response.results) || [])[0], this.config);
                    this.openPopular();
                } catch (error) {
                    console.error('Typesense popular searches request failed', error);
                }
            },

            // Without a query long enough to search, the dropdown shows only the popular searches.
            openPopular() {
                if (!this.isQueryLongEnough() && this.hasPopular() && this.$root.contains(document.activeElement)) {
                    this.isOpen = true;
                }
            },

            reset() {
                this.isOpen = false;
                this.sections = EMPTY_SECTIONS;
                this.rows = [];
                this.found = 0;
                this.crossSells = [];
                this.searchedTerm = '';
                this.activeIndex = -1;
            },

            close() {
                this.isOpen = false;
                this.activeIndex = -1;
            },

            onKeydown() {
                const event = this.$event;
                const total = this.rows.length;
                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                    if (!this.isOpen && total > 0 && this.searchedTerm === this.query.trim()) {
                        // Reopens the results closed with Escape while the input kept focus.
                        event.preventDefault();
                        this.isOpen = true;
                        return;
                    }
                    if (!this.isOpen || total === 0) {
                        return;
                    }
                    event.preventDefault();
                    const step = event.key === 'ArrowDown' ? 1 : -1;
                    this.activeIndex = this.activeIndex < 0 && step < 0
                        ? total - 1
                        : (this.activeIndex + step + total) % total;
                } else if (event.key === 'Enter') {
                    const row = this.activeRow();
                    // Without a highlighted row Enter falls through to the form's native submit.
                    if (this.isOpen && row) {
                        event.preventDefault();
                        this.trackRow(row);
                        window.location.href = row.url;
                    }
                } else if (event.key === 'Escape' && this.isOpen) {
                    // Closes only the dropdown, not the theme's search panel around it.
                    event.preventDefault();
                    event.stopPropagation();
                    this.close();
                }
            },

            onSubmit() {
                const input = this.$refs.input;
                if (!this.isQueryLongEnough()) {
                    this.$event.preventDefault();
                    input.setCustomValidity(hyva.str(strings.minLength, this.minQueryLength()));
                    input.reportValidity();
                    return;
                }
                input.setCustomValidity('');
                this.close();
            },

            focusInput() {
                this.$refs.input.focus();
                this.$refs.input.select();
            },

            activeRow() {
                return this.rows[this.activeIndex] || null;
            },
            trackRow(row) {
                window.dispatchEvent(new CustomEvent('typesense:suggestion-click', {
                    detail: core().suggestionClickDetail(row, this.searchedTerm),
                }));
            },
            onRowClick() {
                this.trackRow(this.row);
            },
            onCardClick() {
                this.trackRow(this.card);
            },
            onPopularClick() {
                this.trackRow(this.chip);
            },
            onSeeAllClick() {
                window.dispatchEvent(new CustomEvent('typesense:suggestion-click', {
                    detail: { type: 'see_all', term: this.searchedTerm, name: this.searchedTerm, url: this.seeAllUrl(), index: 0 },
                }));
            },
            activateRow() {
                this.activeIndex = this.row.position;
            },

            ariaExpanded() {
                return this.isOpen ? 'true' : 'false';
            },
            activeDescendant() {
                const row = this.isOpen ? this.activeRow() : null;

                return row ? row.domId : false;
            },
            rowSelected() {
                return this.row.position === this.activeIndex ? 'true' : 'false';
            },
            rowClasses() {
                return this.row.position === this.activeIndex ? 'bg-gray-100' : '';
            },
            rowPriceText() {
                return hyva.formatPrice(this.row.price);
            },
            rowMeta() {
                return this.row.meta;
            },
            hasRowMeta() {
                return this.row.hasMeta;
            },
            cardPriceText() {
                return hyva.formatPrice(this.card.price);
            },
            cardMeta() {
                return this.card.meta;
            },
            hasCardMeta() {
                return this.card.hasMeta;
            },

            hasSuggestions() {
                return this.sections.suggestions.length > 0;
            },
            hasProducts() {
                return this.sections.products.length > 0;
            },
            hasCategories() {
                return this.sections.categories.length > 0;
            },
            hasPages() {
                return this.sections.pages.length > 0;
            },
            hasCrossSells() {
                return this.crossSells.length > 0;
            },
            hasPopular() {
                return this.popular.length > 0;
            },
            // isIdle: no query searched yet, e.g. the empty input showing only the popular searches.
            isIdle() {
                return this.searchedTerm === '';
            },
            hasSearched() {
                return this.searchedTerm !== '';
            },
            hasFound() {
                return this.found > 0;
            },
            hasNoProducts() {
                return this.found === 0 && this.searchedTerm !== '';
            },
            seeAllUrl() {
                return core() ? core().searchResultUrl(this.config.searchUrl, this.searchedTerm) : '#';
            },
            seeAllText() {
                return hyva.str(strings.seeAll, this.found);
            },
            foundText() {
                return hyva.str(this.found === 1 ? strings.foundOne : strings.foundMany, this.found);
            },
            noResultsText() {
                return hyva.str(strings.noResults, this.searchedTerm);
            },
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('typesenseHeaderSearch', initTypesenseHeaderSearch), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
