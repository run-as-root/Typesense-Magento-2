<?php
/**
 * Header search with Typesense autocomplete, set on the `header-search` block by the typesense_autocomplete handle.
 * Markup only: the Alpine component `typesenseHeaderSearch` comes from the `typesense_script` child block
 * (search/script/header-search.phtml), which a theme override of this template must keep rendering. The form is a
 * plain GET to catalogsearch/result, so Enter always submits it, also when Typesense fails. Dropdown sections are
 * child blocks: suggestion, popular, product, crosssell, category, page, see-all. Row, card and chip clicks dispatch
 * `typesense:suggestion-click` ({type, term, name, url, index, item?}).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use RunAsRoot\TypeSense\ViewModel\Frontend\AutocompleteConfigViewModel;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var AutocompleteConfigViewModel $viewModel */
$viewModel = $block->getData('typesense_autocomplete');
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
?>
<?= $block->getChildHtml('typesense_script') ?>
<div class="typesense-header-search container relative py-2 mx-auto text-black"
     x-data="typesenseHeaderSearch"
     @click.outside="close">
    <script type="application/json" data-typesense-autocomplete-config><?= /* @noEscape */ $viewModel->getJsonConfig() ?></script>
    <search title="<?= $escaper->escapeHtmlAttr(__('Store')) ?>" role="search">
        <form id="search_mini_form"
              class="form minisearch input-group"
              action="<?= $escaper->escapeUrl($viewModel->getResultUrl()) ?>"
              method="get"
              @submit="onSubmit">
            <div class="input-group relative grow">
                <input id="search"
                       x-ref="input"
                       type="search"
                       name="<?= $escaper->escapeHtmlAttr($viewModel->getQueryParamName()) ?>"
                       value="<?= /* @noEscape */ $viewModel->getEscapedQueryText() ?>"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('Search entire store here...')) ?>"
                       maxlength="<?= (int) $viewModel->getMaxQueryLength() ?>"
                       autocomplete="off"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-controls="typesense-autocomplete"
                       :aria-expanded="ariaExpanded"
                       :aria-activedescendant="activeDescendant"
                       class="form-input grow w-full"
                       @input="onInput"
                       @focus="onFocus"
                       @click="onFocus"
                       @keydown="onKeydown"
                       @search-open.window.debounce.10="focusInput">
                <label class="sr-only" for="search"><?= $escaper->escapeHtml(__('Search')) ?></label>
            </div>
            <button type="submit"
                    class="btn btn-primary p-2.5 rounded-s-none shrink-0"
                    title="<?= $escaper->escapeHtmlAttr(__('Search')) ?>"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Search')) ?>">
                <?= $lucideIcons->searchHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
            </button>
        </form>
    </search>
    <div id="typesense-autocomplete"
         x-show="isOpen"
         x-cloak
         role="listbox"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Search suggestions')) ?>"
         class="typesense-autocomplete absolute inset-x-0 z-50 mt-1 max-h-[70vh] overflow-y-auto border border-gray-200 bg-white shadow-lg">
        <?= $block->getChildHtml('typesense_suggestion') ?>
        <?= $block->getChildHtml('typesense_popular') ?>
        <?= $block->getChildHtml('typesense_product') ?>
        <?= $block->getChildHtml('typesense_crosssell') ?>
        <?= $block->getChildHtml('typesense_category') ?>
        <?= $block->getChildHtml('typesense_page') ?>
        <?= $block->getChildHtml('typesense_see_all') ?>
    </div>
</div>
