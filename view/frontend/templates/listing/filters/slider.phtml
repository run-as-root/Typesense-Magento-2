<?php
/**
 * Price slider (`typesenseFilterSlider`): two range inputs and two number inputs inside the bounds of the price
 * facet stats, applied on change and clamped. Not rendered when the listing hides prices (`showPrices`).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$thumbClasses = 'pointer-events-none absolute inset-0 h-6 w-full appearance-none bg-transparent'
    . ' [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-5'
    . ' [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:appearance-none'
    . ' [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-gray-900'
    . ' [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:w-5'
    . ' [&::-moz-range-thumb]:cursor-pointer [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0'
    . ' [&::-moz-range-thumb]:bg-gray-900';
?>
<template x-for="facet in sliderFacets" :key="facet.field">
    <div x-data="typesenseFilterSlider"
         x-effect="syncRange"
         @click.outside="closeOnOutside"
         class="typesense-filter typesense-filter-slider relative border-b border-gray-200 md:border-0">
        <button type="button"
                @click="togglePanelOpen"
                :aria-expanded="isOpen"
                aria-controls="typesense-filter-price"
                class="flex w-full items-center justify-between gap-2 py-4 text-sm font-semibold
                       md:w-auto md:rounded md:border md:border-gray-300 md:bg-white md:px-3 md:py-2 md:font-normal">
            <span class="flex items-center gap-1.5">
                <span x-text="facetLabel"></span>
                <span x-show="hasPriceFilter"
                      class="flex h-5 min-w-5 items-center justify-center rounded-full bg-gray-900 px-1 text-xs text-white">1</span>
            </span>
            <span :class="chevronClasses" class="transition-transform duration-200">
                <?= $heroicons->chevronDownHtml('h-4 w-4', 16, 16, ['aria-hidden' => 'true']) ?>
            </span>
        </button>
        <div x-cloak
             x-show="isOpen"
             id="typesense-filter-price"
             class="pb-4 md:absolute md:left-0 md:top-full md:z-30 md:mt-2 md:w-80 md:rounded md:border
                    md:border-gray-200 md:bg-white md:p-4 md:shadow-lg">
            <div class="flex items-center gap-3">
                <label class="flex-1">
                    <span class="sr-only"><?= $escaper->escapeHtml(__('Minimum price')) ?></span>
                    <input type="number"
                           inputmode="decimal"
                           step="1"
                           :min="rangeMin"
                           :max="rangeMax"
                           :value="minValue"
                           @change="onMinNumberChange"
                           class="form-input w-full text-center text-sm">
                </label>
                <span aria-hidden="true">&ndash;</span>
                <label class="flex-1">
                    <span class="sr-only"><?= $escaper->escapeHtml(__('Maximum price')) ?></span>
                    <input type="number"
                           inputmode="decimal"
                           step="1"
                           :min="rangeMin"
                           :max="rangeMax"
                           :value="maxValue"
                           @change="onMaxNumberChange"
                           class="form-input w-full text-center text-sm">
                </label>
            </div>
            <div class="relative mt-5 h-6">
                <div class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded bg-gray-200" aria-hidden="true"></div>
                <!-- :min/:max are bound before :value, so the browser does not clamp the value to its default 0-100. -->
                <input type="range"
                       step="1"
                       :min="rangeMin"
                       :max="rangeMax"
                       :value="minValue"
                       @input="onMinRangeInput"
                       @change="applyRange"
                       aria-label="<?= $escaper->escapeHtmlAttr(__('Minimum price')) ?>"
                       :aria-valuetext="minValueText"
                       class="<?= $escaper->escapeHtmlAttr($thumbClasses) ?>">
                <input type="range"
                       step="1"
                       :min="rangeMin"
                       :max="rangeMax"
                       :value="maxValue"
                       @input="onMaxRangeInput"
                       @change="applyRange"
                       aria-label="<?= $escaper->escapeHtmlAttr(__('Maximum price')) ?>"
                       :aria-valuetext="maxValueText"
                       class="<?= $escaper->escapeHtmlAttr($thumbClasses) ?>">
            </div>
            <div class="mt-3 flex justify-between text-xs text-gray-600">
                <span x-text="minValueText"></span>
                <span x-text="maxValueText"></span>
            </div>
        </div>
    </div>
</template>
<script>
    function initTypesenseFilterSlider() {
        const core = () => window.runAsRootTypesense && window.runAsRootTypesense.listing;
        const panelKey = 'price';
        const wholeAmounts = () => ({ minimumFractionDigits: 0, maximumFractionDigits: 0 });

        return {
            minValue: 0,
            maxValue: 0,

            bounds() {
                return this.listing.priceStats || { min: 0, max: 0 };
            },
            rangeMin() {
                return this.bounds().min;
            },
            rangeMax() {
                return this.bounds().max;
            },
            // The active price filter, else the full range; re-run whenever the listing state or stats change.
            syncRange() {
                const bounds = this.bounds();
                const price = this.listing.state.price;
                this.minValue = price ? Math.max(bounds.min, Math.min(Number(price.min), bounds.max)) : bounds.min;
                this.maxValue = price ? Math.min(bounds.max, Math.max(Number(price.max), bounds.min)) : bounds.max;
            },
            isOpen() {
                return this.isPanelOpen(panelKey);
            },
            togglePanelOpen() {
                this.togglePanel(panelKey);
            },
            closeOnOutside() {
                this.closePanel(panelKey);
            },
            chevronClasses() {
                return this.isOpen() ? 'rotate-180' : '';
            },
            facetLabel() {
                return this.facet.label;
            },
            minValueText() {
                return hyva.formatPrice(this.minValue, false, wholeAmounts());
            },
            maxValueText() {
                return hyva.formatPrice(this.maxValue, false, wholeAmounts());
            },
            // The thumbs may meet but not cross; the input is reset when the value is held at the other thumb.
            onMinRangeInput() {
                const target = this.$event.target;
                this.minValue = Math.min(Number(target.value), this.maxValue);
                target.value = this.minValue;
            },
            onMaxRangeInput() {
                const target = this.$event.target;
                this.maxValue = Math.max(Number(target.value), this.minValue);
                target.value = this.maxValue;
            },
            onMinNumberChange() {
                this.minValue = Number(this.$event.target.value);
                this.applyRange();
            },
            onMaxNumberChange() {
                this.maxValue = Number(this.$event.target.value);
                this.applyRange();
            },
            applyRange() {
                const range = core() ? core().clampPriceRange(this.minValue, this.maxValue, this.listing.priceStats) : null;
                const current = this.listing.state.price || null;
                if (JSON.stringify(range) === JSON.stringify(current)) {
                    this.syncRange();
                    return;
                }
                this.dispatchFilterChange({ price: range });
            },
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('typesenseFilterSlider', initTypesenseFilterSlider), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
