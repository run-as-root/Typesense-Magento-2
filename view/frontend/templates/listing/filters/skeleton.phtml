<?php
/**
 * Filter bar placeholders until the first result: the mobile "Filter" button and one chip per facet the page usually
 * shows, the category facet first. Chip widths come from the layout argument `filter_chip_widths`. Visible from the
 * first paint (no x-cloak).
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

// The default classes also make Tailwind generate these widths for layout files that pass them.
$chipWidths = $block->getData('filter_chip_widths') ?: ['w-28', 'w-32', 'w-28', 'w-20', 'w-24'];
?>
<div x-show="showControlsSkeleton" class="typesense-filter-skeleton flex items-center gap-3" aria-hidden="true">
    <div class="h-10 w-24 animate-pulse rounded bg-gray-300 md:hidden"></div>
    <?php foreach ($chipWidths as $chipWidth): ?>
        <div class="hidden h-10 animate-pulse rounded bg-gray-300 md:block <?= $escaper->escapeHtmlAttr((string) $chipWidth) ?>"></div>
    <?php endforeach; ?>
</div>
