<?php
/**
 * Multi-select facets (`typesenseFilterDropdown`, one per facet of type dropdown): value counts, an active badge,
 * the first values with More/Less and, for searchable facets, a value search sent as the facet's `facet_query`.
 * The component is shared with subcategory.phtml.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$visibleValues = (int) ($block->getData('visible_values') ?? 5);
?>
<template x-for="facet in dropdownFacets" :key="facet.field">
    <div x-data="typesenseFilterDropdown"
         @click.outside="closeOnOutside"
         data-visible-values="<?= (int) $visibleValues ?>"
         class="typesense-filter typesense-filter-dropdown relative border-b border-gray-200 md:border-0">
        <button type="button"
                @click="togglePanelOpen"
                :aria-expanded="isOpen"
                :aria-controls="panelId"
                class="flex w-full items-center justify-between gap-2 py-4 text-sm font-semibold
                       md:w-auto md:rounded md:border md:border-gray-300 md:bg-white md:px-3 md:py-2 md:font-normal">
            <span class="flex items-center gap-1.5">
                <span x-text="facetLabel"></span>
                <span x-show="hasActiveCount"
                      x-text="activeCount"
                      class="flex h-5 min-w-5 items-center justify-center rounded-full bg-gray-900 px-1 text-xs text-white"></span>
            </span>
            <span :class="chevronClasses" class="transition-transform duration-200">
                <?= $heroicons->chevronDownHtml('h-4 w-4', 16, 16, ['aria-hidden' => 'true']) ?>
            </span>
        </button>
        <div x-cloak
             x-show="isOpen"
             :id="panelId"
             class="pb-4 md:absolute md:left-0 md:top-full md:z-30 md:mt-2 md:min-w-[17.5rem] md:rounded md:border
                    md:border-gray-200 md:bg-white md:p-4 md:shadow-lg">
            <input type="search"
                   x-show="isSearchable"
                   x-ref="valueSearch"
                   x-effect="syncValueSearch"
                   @input.debounce.300ms="onValueSearch"
                   :placeholder="searchPlaceholder"
                   :aria-label="searchPlaceholder"
                   autocomplete="off"
                   class="form-input mb-3 w-full text-sm">
            <fieldset>
                <legend class="sr-only" x-text="facetLabel"></legend>
                <template x-for="option in visibleOptions" :key="option.value">
                    <label class="flex cursor-pointer items-start gap-3 py-1.5 text-sm">
                        <input type="checkbox"
                               :checked="isOptionSelected"
                               @change="toggleOption"
                               class="mt-0.5 shrink-0">
                        <span class="grow" x-text="optionLabel"></span>
                        <span x-show="hasOptionCount" x-text="optionCount" class="text-xs text-gray-500"></span>
                    </label>
                </template>
            </fieldset>
            <p x-show="showNoValues" class="py-1.5 text-sm text-gray-500">
                <?= $escaper->escapeHtml(__('No matching values')) ?>
            </p>
            <button type="button"
                    x-show="showMoreToggle"
                    @click="toggleExpanded"
                    :aria-expanded="expanded"
                    class="mt-2 text-sm underline"
                    x-text="moreLessText"></button>
        </div>
    </div>
</template>
<script>
    function initTypesenseFilterDropdown() {
        const strings = {
            more: '<?= $escaper->escapeJs(__('More')) ?>',
            less: '<?= $escaper->escapeJs(__('Less')) ?>',
            search: '<?= $escaper->escapeJs(__('Search %1')) ?>',
        };

        return {
            expanded: false,
            visibleValues: 5,

            init() {
                this.visibleValues = Number(this.$root.dataset.visibleValues) || 5;
            },
            panelKey() {
                return 'facet:' + this.facet.field;
            },
            panelId() {
                return 'typesense-filter-' + this.facet.field.replace(/[^A-Za-z0-9_-]/g, '-');
            },
            isOpen() {
                return this.isPanelOpen(this.panelKey());
            },
            togglePanelOpen() {
                this.togglePanel(this.panelKey());
            },
            closeOnOutside() {
                this.closePanel(this.panelKey());
            },
            chevronClasses() {
                return this.isOpen() ? 'rotate-180' : '';
            },
            facetLabel() {
                return this.facet.label;
            },
            activeCount() {
                return this.selectedValues(this.facet.field).length;
            },
            hasActiveCount() {
                return this.activeCount() > 0;
            },
            options() {
                return this.facetOptionsFor(this.facet);
            },
            visibleOptions() {
                const options = this.options();

                return this.expanded ? options : options.slice(0, this.visibleValues);
            },
            showMoreToggle() {
                return this.options().length > this.visibleValues;
            },
            moreLessText() {
                return this.expanded ? strings.less : strings.more;
            },
            toggleExpanded() {
                this.expanded = !this.expanded;
            },
            showNoValues() {
                return this.options().length === 0;
            },

            isSearchable() {
                return this.facet.searchable === true;
            },
            searchPlaceholder() {
                return hyva.str(strings.search, this.facet.label);
            },
            onValueSearch() {
                this.dispatchFilterChange({ field: this.facet.field, facetQuery: this.$event.target.value.trim() });
            },
            // Follows Clear All and back/forward, but never rewrites the field while the shopper types in it.
            syncValueSearch() {
                const input = this.$refs.valueSearch;
                const value = this.facetValueSearch(this.facet.field);
                if (input && input !== document.activeElement && input.value.trim() !== value) {
                    input.value = value;
                }
            },

            isOptionSelected() {
                return this.option.selected;
            },
            optionLabel() {
                return this.option.label;
            },
            optionCount() {
                return this.option.count;
            },
            hasOptionCount() {
                return this.option.count !== null;
            },
            toggleOption() {
                this.dispatchFilterChange({ field: this.facet.field, value: this.option.value, action: 'toggle' });
            },
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('typesenseFilterDropdown', initTypesenseFilterDropdown), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
