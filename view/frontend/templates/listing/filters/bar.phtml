<?php
/**
 * Filter bar (`typesenseFilterBar`): a chip row with one popover per facet on desktop, a drawer below `md`.
 * Facets are routed by their configured type (category, dropdown, slider, checkbox); every change is sent
 * to the listing as a `typesense-filter-change` event. Children: skeleton, drawer (with the facet slots),
 * active-filters.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);
?>
<div x-data="typesenseFilterBar"
     @typesense-state.window="onListingState"
     @keydown.escape.window="onEscape"
     class="typesense-filter-bar">
    <div class="flex flex-wrap items-center gap-2 md:gap-3">
        <button type="button"
                x-ref="drawerToggle"
                x-cloak
                x-show="showDrawerToggle"
                @click="openDrawer"
                aria-controls="typesense-filter-drawer"
                :aria-expanded="drawerOpen"
                class="btn flex items-center gap-2 px-3 py-2 text-sm font-semibold md:hidden">
            <?= $heroicons->filterHtml('h-4 w-4', 16, 16, ['aria-hidden' => 'true']) ?>
            <span><?= $escaper->escapeHtml(__('Filter')) ?></span>
            <span x-show="hasActiveFilterCount"
                  x-text="activeFilterCount"
                  class="flex h-5 min-w-5 items-center justify-center rounded-full bg-white px-1 text-xs text-gray-900"></span>
        </button>
        <span x-cloak x-show="showFacets" class="hidden items-center gap-2 text-sm font-semibold md:flex">
            <?= $heroicons->filterHtml('h-4 w-4', 16, 16, ['aria-hidden' => 'true']) ?>
            <span><?= $escaper->escapeHtml(__('Filter')) ?></span>
            <span x-show="hasActiveFilterCount"
                  x-text="activeFilterCount"
                  class="flex h-5 min-w-5 items-center justify-center rounded-full bg-gray-900 px-1 text-xs text-white"></span>
        </span>
        <?= $block->getChildHtml('skeleton') ?>
        <?= $block->getChildHtml('drawer') ?>
    </div>
    <?= $block->getChildHtml('active-filters') ?>
</div>
