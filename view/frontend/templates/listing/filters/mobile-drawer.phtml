<?php
/**
 * The facet container of the filter bar. Below `md` it is a modal drawer (backdrop, scroll lock, focus trap,
 * `inert` while closed, footer with "Show N items" and Reset, mobile sorting inside); from `md` up the same
 * element is the inline chip row. Its drawer state is a mixin of `typesenseFilterBar`.
 * Children: sorting-mobile, subcategory, dropdown, slider, checkbox.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);
?>
<div x-cloak
     x-show="drawerOpen"
     x-transition.opacity
     @click="closeDrawer"
     class="fixed inset-0 z-40 bg-black/60 md:hidden"
     aria-hidden="true"></div>
<div id="typesense-filter-drawer"
     x-ref="drawer"
     x-cloak
     x-show="showControls"
     :class="drawerClasses"
     :inert="drawerInert"
     :role="drawerRole"
     :aria-modal="drawerModal"
     aria-labelledby="typesense-filter-drawer-title"
     class="typesense-filter-drawer fixed inset-y-0 left-0 z-50 flex w-full max-w-sm flex-col bg-white transition-transform duration-300
            md:static md:z-auto md:w-auto md:max-w-none md:flex-row md:bg-transparent md:transition-none">
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 md:hidden">
        <h2 id="typesense-filter-drawer-title" class="text-lg font-bold"><?= $escaper->escapeHtml(__('Filter')) ?></h2>
        <button type="button"
                @click="closeDrawer"
                class="p-2"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Close filters')) ?>">
            <?= $heroicons->xHtml('h-6 w-6', 24, 24, ['aria-hidden' => 'true']) ?>
        </button>
    </div>
    <div class="flex-1 overflow-y-auto px-4 md:flex md:flex-wrap md:items-center md:gap-3 md:overflow-visible md:px-0">
        <?= $block->getChildHtml('sorting-mobile') ?>
        <?= $block->getChildHtml('subcategory') ?>
        <?= $block->getChildHtml('dropdown') ?>
        <?= $block->getChildHtml('slider') ?>
        <?= $block->getChildHtml('checkbox') ?>
    </div>
    <div class="flex gap-3 border-t border-gray-200 bg-white p-4 shadow-[0_-4px_14px_rgba(0,0,0,0.06)] md:hidden">
        <button type="button"
                x-show="hasActiveFilterCount"
                @click="resetFilters"
                class="btn flex-1 justify-center">
            <?= $escaper->escapeHtml(__('Reset')) ?>
        </button>
        <button type="button"
                @click="closeDrawer"
                class="btn btn-primary flex-1 justify-center"
                x-text="showItemsText"></button>
    </div>
</div>
<script>
    function typesenseFilterDrawer() {
        const strings = {
            showItem: '<?= $escaper->escapeJs(__('Show %1 item')) ?>',
            showItems: '<?= $escaper->escapeJs(__('Show %1 items')) ?>',
        };

        return {
            drawerOpen: false,

            openDrawer() {
                this.drawerOpen = true;
                document.body.classList.add('overflow-hidden');
                this.$nextTick(() => hyva.trapFocus(this.$refs.drawer));
            },
            closeDrawer() {
                if (!this.drawerOpen) {
                    return;
                }
                this.resetDrawer();
                this.$nextTick(() => this.$refs.drawerToggle && this.$refs.drawerToggle.focus());
            },
            // Leaving the mobile layout with the drawer open must not keep the page scroll-locked.
            resetDrawer() {
                this.drawerOpen = false;
                document.body.classList.remove('overflow-hidden');
                hyva.releaseFocus(this.$refs.drawer);
            },
            resetFilters() {
                this.dispatchFilterChange({ clear: true });
            },
            // No translate on desktop: a transform would make the row a stacking context below the product grid,
            // hiding the facet popovers behind the tiles.
            drawerClasses() {
                if (this.isDesktop) {
                    return '';
                }

                return this.drawerOpen ? 'translate-x-0' : '-translate-x-full';
            },
            drawerInert() {
                return !this.isDesktop && !this.drawerOpen;
            },
            drawerRole() {
                return this.isDesktop ? false : 'dialog';
            },
            drawerModal() {
                return this.isDesktop ? false : 'true';
            },
            showItemsText() {
                const found = Number(this.listing.found) || 0;

                return hyva.str(found === 1 ? strings.showItem : strings.showItems, found);
            },
        };
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>
