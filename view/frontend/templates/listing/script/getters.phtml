<?php
/**
 * Mixin of `typesenseListing`: the argument-free getters and click handlers the slot templates bind to.
 * Loop variables of x-for (e.g. `pageNumber`) are read from `this`.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    function typesenseListingGetters() {
        const strings = {
            product: '<?= $escaper->escapeJs(__('%1 product')) ?>',
            products: '<?= $escaper->escapeJs(__('%1 products')) ?>',
            page: '<?= $escaper->escapeJs(__('Page %1')) ?>',
            noResultsForQuery: '<?= $escaper->escapeJs(__('We couldn\'t find any results for "%1".')) ?>',
            noFilteredResultsForQuery: '<?= $escaper->escapeJs(__('We couldn\'t find any results for "%1" with the selected filters.')) ?>',
        };
        const core = () => window.runAsRootTypesense && window.runAsRootTypesense.listing;

        return {
            showSkeleton() {
                return !this.hasLoaded;
            },
            showOverlay() {
                return this.isLoading && this.hasLoaded;
            },
            hasHits() {
                return this.hits.length > 0;
            },
            showGrid() {
                return this.showSkeleton() || this.hasHits();
            },
            showCount() {
                return this.hasLoaded && this.error === null;
            },
            showCountSkeleton() {
                return !this.hasLoaded;
            },
            countText() {
                return hyva.str(this.found === 1 ? strings.product : strings.products, this.found);
            },
            showNoResults() {
                return this.hasLoaded && this.hits.length === 0;
            },
            hasError() {
                return this.error !== null;
            },
            hasActiveFilters() {
                return Object.keys(this.state.filters).length > 0 || this.state.price !== null;
            },
            showFilteredMessage() {
                return !this.hasError() && this.hasActiveFilters();
            },
            showUnfilteredMessage() {
                return !this.hasError() && !this.hasActiveFilters();
            },
            searchQuery() {
                return this.state.q;
            },
            noResultsForQueryText() {
                return hyva.str(strings.noResultsForQuery, this.state.q);
            },
            noFilteredResultsForQueryText() {
                return hyva.str(strings.noFilteredResultsForQuery, this.state.q);
            },
            hasSuggestedHits() {
                return this.suggestedHits.length > 0;
            },
            showSuggestedOverlay() {
                return this.isLoadingSuggested;
            },
            hasAiAnswer() {
                return this.aiAnswer !== '';
            },
            totalPages() {
                const limit = this.currentLimit || Number(this.config.perPage) || 1;

                return Math.max(1, Math.ceil((Number(this.found) || 0) / limit));
            },
            showPagination() {
                return this.hasLoaded && this.hits.length > 0 && this.totalPages() > 1;
            },
            pages() {
                return core() ? core().paginationWindow(this.state.page, this.totalPages(), 5) : [];
            },
            isFirstPage() {
                return this.state.page <= 1;
            },
            isLastPage() {
                return this.state.page >= this.totalPages();
            },
            isCurrentPage() {
                return this.pageNumber === this.state.page;
            },
            pageClasses() {
                return this.isCurrentPage() ? 'bg-gray-900 text-white' : 'hover:bg-gray-100';
            },
            prevPageClasses() {
                return this.isFirstPage() ? 'pointer-events-none opacity-40' : '';
            },
            nextPageClasses() {
                return this.isLastPage() ? 'pointer-events-none opacity-40' : '';
            },
            currentPageMarker() {
                return this.isCurrentPage() ? 'page' : false;
            },
            pageLabel() {
                return hyva.str(strings.page, this.pageNumber);
            },
            pageHref() {
                return this.hrefForPage(this.pageNumber);
            },
            prevPageHref() {
                return this.hrefForPage(Math.max(1, this.state.page - 1));
            },
            nextPageHref() {
                return this.hrefForPage(Math.min(this.totalPages(), this.state.page + 1));
            },
            hrefForPage(page) {
                const state = Object.assign({}, this.state, { page });

                return window.location.pathname + (core() ? core().serializeUrlState(state, this.config) : '');
            },
            goToPage() {
                this.setPage(this.pageNumber);
            },
            goToPrevPage() {
                this.setPage(this.state.page - 1);
            },
            goToNextPage() {
                this.setPage(this.state.page + 1);
            },
        };
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>
