<?xml version="1.0"?>
<!-- Added by Observer\LayoutLoadBefore on category pages while the module and "Replace Category Pages" are enabled. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="typesense_listing"/>
    <body>
        <referenceBlock name="typesense.listing">
            <arguments>
                <argument name="listing_context" xsi:type="string">category</argument>
            </arguments>
        </referenceBlock>

        <!-- Magento's product listing, toolbar and layered navigation are replaced by the Typesense listing. -->
        <referenceBlock name="category.products" remove="true"/>
        <referenceBlock name="catalog.leftnav" remove="true"/>
    </body>
</page>
