        <span class="ts-vrule-root-name" id="typesense-vrule-root-name">
            <?= $block->getVirtualCategoryRootName() !== null
                ? $block->escapeHtml(__('Currently: %1', $block->getVirtualCategoryRootName()))
                : $block->escapeHtml(__('Optional — leave empty for no inherited root.')) ?>
        </span>
