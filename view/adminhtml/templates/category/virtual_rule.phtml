             class="rule-tree-wrapper"
             data-role="virtual-rule-conditions">
            <?= /* @noEscape */ $block->getConditionsHtml() ?>
        </div>
    </div>

    <button type="button" class="ts-vrule-save" id="typesense-vrule-save-btn">
        <?= $block->escapeHtml(__('Save Virtual Rule')) ?>
    </button>
    <span id="typesense-vrule-status" class="ts-vrule-status"></span>
</div>

<script>
require(['jquery', 'Magento_Rule/rules', 'prototype'], function ($, VarienRulesForm) {
    'use strict';

    var $container = $('#typesense-category-virtual-rule');
    var jsObjectName = $container.data('js-object-name');
    var newChildUrl = $container.data('new-child-url');
    var saveUrl = $container.data('save-url');
    var categoryId = $container.data('category-id');
    var storeId = $container.data('store-id');

    // Boot Magento's own rule builder JS against our rendered condition tree. Exposed on
    // `window` under the fieldset id, matching Magento_CatalogRule::promo/fieldset.phtml's own
    // convention, since rules.js's AJAX "add new condition" flow reads back the FORM_KEY/BASE_URL
    // globals it expects to already be present on every admin page.
    window[jsObjectName] = new VarienRulesForm(jsObjectName, newChildUrl);

    function showStatus(msg, type) {
        var $status = $('#typesense-vrule-status');
        $status.text(msg)
            .removeClass('status-success status-error')
            .addClass(type === 'success' ? 'status-success' : 'status-error');
        setTimeout(function () { $status.text(''); }, 4000);
    }

    function saveRule() {
        var $btn = $('#typesense-vrule-save-btn');
        $btn.prop('disabled', true);

        // Serializing the individual condition inputs (rather than a <form>) is intentional: this
        // block is embedded inside the category edit page's own UI-component <form>, and nesting a
        // second literal <form> element inside it would be invalid HTML. jQuery's .serialize()
        // works fine against a plain set of matched input/select elements, it does not require
        // them to be wrapped in a <form> tag.
        var conditionsData = $('#' + jsObjectName)
            .find(':input')
            .serialize();

        var payload = $.param({
            category_id: categoryId,
            store_id: storeId,
            is_virtual: $('#typesense-vrule-is-virtual').is(':checked') ? 1 : 0,
            virtual_category_root_id: $('#typesense-vrule-root-id').val(),
            form_key: window.FORM_KEY
        }) + '&' + conditionsData;

        $.ajax({
            url: saveUrl,
            type: 'POST',
            data: payload,
            dataType: 'json',
            success: function (response) {
                if (response && response.success) {
                    showStatus('<?= $block->escapeJs(__('Virtual rule saved successfully.')) ?>', 'success');
                } else {
                    var msg = (response && response.message)
                        ? response.message
                        : '<?= $block->escapeJs(__('An error occurred while saving.')) ?>';
                    showStatus(msg, 'error');
                }
            },
            error: function () {
                showStatus('<?= $block->escapeJs(__('Failed to save virtual rule. Please try again.')) ?>', 'error');
            },
            complete: function () {
                $btn.prop('disabled', false);
            }
        });
    }

    $('#typesense-vrule-save-btn').on('click', saveRule);
});
</script>
