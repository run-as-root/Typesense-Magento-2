<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="typesense_merchandising" sortOrder="50">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">TypeSense Merchandising</label>
        </settings>
        <htmlContent name="typesense_category_merchandiser">
            <argument name="block" xsi:type="object">RunAsRoot\TypeSense\Block\Adminhtml\Category\Merchandiser</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/form/components/html</item>
                </item>
            </argument>
        </htmlContent>
    </fieldset>
    <fieldset name="typesense_filters" sortOrder="46">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">TypeSense Filters</label>
        </settings>
        <field name="typesense_facet_display_submitted" formElement="hidden">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <dataScope>typesense_facet_display_submitted</dataScope>
            </settings>
        </field>
        <dynamicRows name="typesense_facet_display">
            <settings>
                <addButtonLabel translate="true">Add Filter Setting</addButtonLabel>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
                <componentType>dynamicRows</componentType>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
                <label translate="true">Filters on this category page (all store views)</label>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="attribute_code" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Filter</label>
                        <dataScope>attribute_code</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <caption translate="true">-- Please Select --</caption>
                                <options class="RunAsRoot\TypeSense\Model\Config\Source\FacetAttributeSource"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="display_mode" formElement="select" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Display</label>
                        <dataScope>display_mode</dataScope>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="RunAsRoot\TypeSense\Model\Config\Source\FacetDisplayMode"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                        <componentType>actionDelete</componentType>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
    <fieldset name="typesense_virtual_category" sortOrder="45">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">TypeSense Virtual Category</label>
        </settings>
        <htmlContent name="typesense_category_virtual_rule">
            <argument name="block" xsi:type="object">RunAsRoot\TypeSense\Block\Adminhtml\Category\VirtualRule</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/form/components/html</item>
                </item>
            </argument>
        </htmlContent>
    </fieldset>
</form>
