{
    "name": "run-as-root/magento2-typesense",
    "description": "Open-source Typesense search integration for Magento 2 / Mage-OS with visual merchandising",
    "type": "magento2-module",
    "license": "MIT",
    "version": "0.2.0",
    "require": {
        "php": "^8.3",
        "typesense/typesense-php": "^6.0",
        "openai-php/client": "^0.19 || ^0.20",
        "run-as-root/german-compound-splitter": "^1.0",
        "magento/module-inventory-sales-api": "^1.2",
        "magento/module-inventory-configuration-api": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "RunAsRoot\\TypeSense\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RunAsRoot\\TypeSense\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit --testdox"
    }
}
